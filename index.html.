<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Stock Élec</title><script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script><style>body{font-family:-apple-system,BlinkMacSystemFont,Arial;margin:0;padding:18px;background:#f2f4f7}main{max-width:760px;margin:auto}.card{background:white;border-radius:18px;padding:18px;margin:12px 0;box-shadow:0 3px 14px #0001}input,button{width:100%;padding:13px;margin:5px 0;border-radius:10px;border:1px solid #ccc;font-size:16px}button{background:#111;color:white;font-weight:600}#reader{width:100%;margin-top:10px}.hidden{display:none}.green{background:#238636}.red{background:#c62828}table{width:100%;border-collapse:collapse}td,th{padding:9px;border-bottom:1px solid #ddd;text-align:left}.low{color:#c62828;font-weight:bold}</style></head><body><main><div class="card"><h1>📦 Stock Élec</h1><p>Gestion du matériel par QR code — compatible iPhone/Safari.</p></div><div class="card"><h2>📷 Scanner</h2><button onclick="scan()">Ouvrir la caméra</button><div id="reader" class="hidden"></div><p id="msg"></p><input id="ref" placeholder="Référence, ex. DISJ-016"><button onclick="find()">Rechercher</button></div><div id="prod" class="card hidden"><h2 id="name"></h2><p>Référence : <b id="r"></b></p><p>Emplacement : <b id="loc"></b></p><p>Stock : <b id="qtyStock"></b></p><p>Minimum : <b id="min"></b></p><input id="q" type="number" min="1" value="1"><button class="green" onclick="move(1)">➕ Entrée</button><button class="red" onclick="move(-1)">➖ Sortie</button></div><div class="card"><h2>📋 Stock</h2><table><thead><tr><th>Réf.</th><th>Produit</th><th>Qté</th><th>Emplacement</th></tr></thead><tbody id="list"></tbody></table></div></main><script>
let s=JSON.parse(localStorage.getItem("stockElec")||"null")||[{ref:"DISJ-016",name:"Disjoncteur 16 A",stock:42,min:10,loc:"B2"},{ref:"PRISE-001",name:"Prise 16 A",stock:86,min:20,loc:"A3"},{ref:"CABLE-15",name:"Câble 1,5 mm²",stock:350,min:100,loc:"C1"}],cur=null,qr=null;
function save(){localStorage.setItem("stockElec",JSON.stringify(s));render()}
function render(){list.innerHTML=s.map(p=>`<tr><td>${p.ref}</td><td>${p.name}</td><td class="${p.stock<=p.min?'low':''}">${p.stock}${p.stock<=p.min?' ⚠️':''}</td><td>${p.loc}</td></tr>`).join("")}
function find(){let x=ref.value.trim().toUpperCase();cur=s.find(p=>p.ref===x);if(!cur){prod.classList.add("hidden");msg.textContent="❌ Produit introuvable";return}prod.classList.remove("hidden");name.textContent=cur.name;r.textContent=cur.ref;loc.textContent=cur.loc;qtyStock.textContent=cur.stock;min.textContent=cur.min;msg.textContent="✅ Produit trouvé"}
function move(sign){cur.stock=Math.max(0,cur.stock+sign*Math.max(1,Number(q.value)||1));save();find()}
async function scan(){reader.classList.remove("hidden");msg.textContent="📷 Autorise la caméra dans Safari.";if(qr){try{await qr.clear()}catch(e){}}qr=new Html5Qrcode("reader");try{await qr.start({facingMode:"environment"},{fps:10,qrbox:{width:250,height:250}},async text=>{ref.value=text.trim();msg.textContent="✅ QR détecté";try{await qr.stop()}catch(e){}reader.classList.add("hidden");find()},()=>{})}catch(e){reader.classList.add("hidden");msg.textContent="❌ Caméra inaccessible. Autorise la caméra et ouvre la page depuis une adresse HTTPS."}}
render();
</script></body></html>
